# Copy to .env and fill in. .env is gitignored, so nothing here is ever committed.

# --- Rhombus login (API + UI tests) ---
# Leave these empty: `npm run test:api` / `test:ui` ask for your test account at the prompt and never store it.
# (Only set them in CI, from the CI's secret store.)
RHOMBUS_EMAIL=
RHOMBUS_PASSWORD=
# Only if your test account uses an authenticator app (MFA): the setup secret, so CI can answer it.
RHOMBUS_TOTP_SECRET=
RHOMBUS_BASE_URL=https://rhombusai.com
# Optional: which project the API pipeline test reads. Default: your newest project with a full pipeline.
RHOMBUS_PROJECT_ID=

# --- AWS (UI test + data scripts) ---
# A dedicated IAM user that can read/write your bucket's input/ folder. Not your root account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_SOURCE_BUCKET=
# Optional: the S3 object the UI test imports. Default: input/archive/fuelcheck_baseline.xlsx,
# which `python scripts/upload_dataset.py baseline` creates.
UI_SOURCE_KEY=

# --- GCS (UI test only) ---
# Full path to the service-account JSON Rhombus writes with. Keep the file OUTSIDE the repo.
RHOMBUS_GCS_KEY_FILE=
# Your GCS bucket, and the name the destination shows in Rhombus (usually the same).
GCS_OUTPUT_BUCKET=
GCS_DESTINATION_NAME=
